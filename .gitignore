# Build trees: one per preset under build/<preset>/ (linux-debug, windows-debug, ...),
# so Linux and Windows builds of the same checkout never share a directory.
/build/
# Visual Studio "Open Folder" default build location
/out/

# vcpkg: manifest mode installs into each build tree; this catches an install
# run from the source root by hand
/vcpkg_installed/

# Personal CMake presets (local paths, compilers); shared presets live in CMakePresets.json
CMakeUserPresets.json

# Tooling output
.cache/
compile_commands.json
__pycache__/

# IDEs
.vs/
.vscode/
.idea/
*.user
*.suo

# Editors
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Robot recordings: large binary data does not belong in git. Sessions go in
# recordings/; small recordings meant as test fixtures live in tests/data/.
/recordings/
*.h5
*.ecraw
!/tests/data/*.ecraw

# The vendor's EC66 manuals (Ver3.19.2, about 57 MB): a local reference copy
/docs/EC66/

# Claude Code files and the old decision records (archived) stay local (also
# listed in .git/info/exclude, which old commits cannot override)
/CLAUDE.md
/.claude/
/docs/adr/
/docs/archive/adr/
