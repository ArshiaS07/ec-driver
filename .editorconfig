# Editor settings for every contributor's editor (VS, VS Code, CLion, vim, ...).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# trailing double spaces are line breaks in Markdown
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
